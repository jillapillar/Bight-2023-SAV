# overall condition plot
overall.plot.1<-wt.overall.cond.bight.2 %>%
filter(Category!="Total") %>%
mutate(stratum=factor(Subpopulation, levels = c("All Sites", "large_embayment", "small_embayment", "estuary"),
labels = c("Souther California\nBight", "Large Embayments", "Small Embayments", "Estuaries")),
overall.cond=factor(Category, levels=c("moderate condition", "poor condition", "good condition"))) %>%
naniar::replace_with_na(., replace=list(Estimate.P=0)) %>%
ggplot(., aes(x=stratum, y=Estimate.P, colour = overall.cond, ymin = LCB95Pct.P, ymax=UCB95Pct.P))+
theme_bw()+
theme(panel.grid = element_blank(),
axis.title = element_text(face="bold", size=18),
axis.text.x=element_text(face="bold", size=16, hjust = 1, angle = 45))+
geom_pointrange(size=0.5, position = position_dodge(width=0.5))+
labs(x="Stratum", y="Percent of Area (+/- 95% CI)", colour="Overall\nCondition")+
scale_color_manual(values=c("#666699", "#CC6600", "plum1"),
labels=c("Moderate", "Poor", "Good"))+
NULL
